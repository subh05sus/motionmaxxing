#!/bin/bash
# motionmaxxing: open the studio (starting it when it is not running), or stop it.
#
#   mm            start the studio if needed and open it in the browser
#   mm start      start it without opening the browser
#   mm stop       stop the studio
#   mm status     say whether it runs
#   mm login      sign in to Claude once: the studio's Claude runs on your subscription (no API key)
#   mm doctor     what this Mac has and what it still needs
#   mm setup      install what is missing (the setup page's button, here in the terminal)
#   mm app        put motionmaxxing.app in ~/Applications (for the Dock)
#   mm logs       the studio's log
set -euo pipefail

SELF="$0"
while [ -L "$SELF" ]; do
  L="$(readlink "$SELF")"; case "$L" in /*) SELF="$L" ;; *) SELF="$(dirname "$SELF")/$L" ;; esac
done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
PORT="${MM_PORT:-5199}"
HOME_DIR="${MM_HOME:-$HOME/.motionmaxxing}"
LOG="$HOME_DIR/studio/studio.log"
PIDF="$HOME_DIR/studio/studio.pid"
URL="http://localhost:$PORT"
mkdir -p "$HOME_DIR/studio"
# Finder and the Dock start apps with a bare PATH: Homebrew's node, ffmpeg and whisper-cli must be found.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

running() { curl -s -o /dev/null --max-time 1 "$URL/api/state"; }
setup_py() { python3 "$ROOT/plugin/skills/setup/scripts/setup.py" "$@"; }
# the Claude Code the studio runs: the Agent SDK's own binary, which npm install brings
claude_bin() {
  local b="$ROOT/node_modules/@anthropic-ai/claude-agent-sdk-darwin-$(uname -m | sed 's/x86_64/x64/')/claude"
  if [ -x "$b" ]; then echo "$b"; else command -v claude || true; fi
}

start() {
  if running; then return 0; fi
  if [ ! -d "$ROOT/node_modules" ]; then (cd "$ROOT" && npm install --silent); fi
  if [ ! -f "$ROOT/web/dist/index.html" ] || [ -n "$(find "$ROOT/web/src" -newer "$ROOT/web/dist/index.html" -type f -print -quit)" ]; then
    (cd "$ROOT" && npm run build --silent >>"$LOG" 2>&1)
  fi
  # exec: the pid file holds the server itself, not a shell that started it (stop killed that shell and left the
  # server running)
  (cd "$ROOT" && exec nohup "$ROOT/node_modules/.bin/tsx" src/server/main.ts >>"$LOG" 2>&1) &
  echo $! >"$PIDF"
  for _ in $(seq 1 40); do running && return 0; sleep 0.25; done
  echo "The studio did not start. Its log: $LOG" >&2
  tail -20 "$LOG" >&2
  exit 1
}

case "${1:-open}" in
  open|"")
    start
    open "$URL"
    ;;
  start)
    start
    echo "running at $URL"
    ;;
  login)
    B="$(claude_bin)"
    if [ -z "$B" ]; then echo "Claude Code is not here yet: run npm install in $ROOT first." >&2; exit 1; fi
    "$B" auth login --claudeai
    ;;
  doctor)
    setup_py doctor
    ;;
  setup)
    setup_py install-all
    ;;
  stop)
    # this studio only: its pid and whatever serves its port, never another studio on this Mac (a pkill of every
    # main.ts took one on another port down)
    stopped=""
    for p in $( { cat "$PIDF" 2>/dev/null; lsof -nP -t -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null; } | sort -u || true); do
      kill "$p" 2>/dev/null && stopped=1
    done
    rm -f "$PIDF"
    for _ in $(seq 1 40); do running || break; sleep 0.25; done   # free, so a start right after starts it again
    if [ -n "$stopped" ]; then echo "stopped"; else echo "not running"; fi
    ;;
  status)
    if running; then echo "running at $URL"; else echo "not running"; fi
    ;;
  logs)
    tail -50 "$LOG"
    ;;
  app)
    bash "$ROOT/scripts/make-app.sh"
    ;;
  *)
    sed -n 2,12p "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
